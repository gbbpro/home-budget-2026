# Neon connection string (Vercel adds this automatically when you connect Neon via the Storage tab)
DATABASE_URL="postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Long random string used to sign login tokens. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional: free key from https://finnhub.io for live stock/ETF prices on the Investments page
FINNHUB_API_KEY=""
